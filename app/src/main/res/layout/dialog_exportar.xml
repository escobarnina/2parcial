<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_margin="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:background="#FFFFFF">

        <!-- Icono circular con fondo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconoExportar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E3F2FD"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivIconoExportar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_save"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:tint="#2196F3" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloExportar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exportar Asistencia"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="8dp" />

        <!-- Información de la materia -->
        <TextView
            android:id="@+id/tvMateriaInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Botones de exportación -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportarExcel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/docente_exportar_excel"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:padding="16dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="#4CAF50"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportarPDF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/docente_exportar_pdf"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:padding="16dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="#F44336"
            android:layout_marginBottom="12dp" />

        <!-- Botón de cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:padding="12dp"
            app:backgroundTint="#757575"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

