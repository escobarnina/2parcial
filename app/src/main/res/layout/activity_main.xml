<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_university"
    tools:context=".MainActivity">

    <!-- Overlay con gradiente para mejor legibilidad -->
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <!-- Contenedor principal con scroll -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header colapsable personalizado -->
            <FrameLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:minHeight="80dp">

                <LinearLayout
                    android:id="@+id/headerContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:paddingTop="48dp"
                    android:paddingBottom="32dp">

                    <!-- Icono que se reduce -->
                    <ImageView
                        android:id="@+id/ivIcono"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/ic_school_24"
                        android:contentDescription="@string/app_name"
                        android:tint="@android:color/white"
                        android:layout_marginBottom="24dp" />

                    <!-- Título que cambia de tamaño -->
                    <TextView
                        android:id="@+id/tvTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_title"
                        android:textColor="@android:color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Toolbar colapsado (inicialmente invisible) -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarCollapsed"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivIconoCollapsed"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_school_24"
                        android:contentDescription="@string/app_name"
                        android:tint="@android:color/white"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvTituloCollapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_title"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </androidx.appcompat.widget.Toolbar>
            </FrameLayout>

            <!-- Contenido principal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <!-- Card para Modo Estudiante -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEstudiante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="12dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:rippleColor="#E3F2FD"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:gravity="center">

                        <!-- Icono grande -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            app:cardCornerRadius="60dp"
                            app:cardElevation="8dp"
                            app:cardBackgroundColor="#E3F2FD"
                            android:layout_marginBottom="24dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_person_24"
                                android:contentDescription="@string/modo_estudiante"
                                android:padding="32dp"
                                android:tint="#2196F3" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Título -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modo_estudiante"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:layout_marginBottom="12dp" />

                        <!-- Descripción -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modo_estudiante_desc"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="24dp" />

                        <!-- Botón de acción -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModoEstudiante"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="@string/ingresar"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/ripple_blue"
                            android:textColor="@android:color/white"
                            app:icon="@drawable/ic_assignment_24"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp"
                            app:iconTint="@android:color/white"
                            app:cornerRadius="28dp"
                            android:elevation="4dp"
                            app:elevation="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card para Modo Docente -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDocente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="12dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:rippleColor="#FFF3E0"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:gravity="center">

                        <!-- Icono grande -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            app:cardCornerRadius="60dp"
                            app:cardElevation="8dp"
                            app:cardBackgroundColor="#FFF3E0"
                            android:layout_marginBottom="24dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_bar_chart_24"
                                android:contentDescription="@string/modo_docente"
                                android:padding="32dp"
                                android:tint="#FF9800" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Título -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modo_docente"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:layout_marginBottom="12dp" />

                        <!-- Descripción -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modo_docente_desc"
                            android:textSize="15sp"
                            android:textColor="#757575"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="24dp" />

                        <!-- Botón de acción -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModoDocente"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="@string/ingresar"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/ripple_orange"
                            android:textColor="@android:color/white"
                            app:icon="@drawable/ic_bar_chart_24"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp"
                            app:iconTint="@android:color/white"
                            app:cornerRadius="28dp"
                            android:elevation="4dp"
                            app:elevation="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
